---
export const prerender = false;

import { getTicket } from "../../lib/tickets.js";
import { formatShowtime } from "../../lib/showtimes.js";
import { formatCents } from "../../lib/money.js";

// Read straight from D1. This is a record, not a cache: if the read fails the
// page should error rather than invent an order summary.
const ticket = await getTicket(Astro.params.id);

if (!ticket) {
  return new Response("Ticket not found", { status: 404 });
}

const total = ticket.unit_price_cents * ticket.seats;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout — {ticket.movie_title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href={`/movie/${ticket.movie_id}`} class="back">← Back to {ticket.movie_title}</a>

    <div class="panel" data-ticket-id={ticket.id}>
      <h1>Checkout</h1>
      <p class="mock-note">
        <strong>Mock checkout.</strong> No payment is taken and no card details are collected.
        Pressing Pay only flips this booking's status in the database.
      </p>

      <dl class="summary">
        <div><dt>Movie</dt><dd>{ticket.movie_title}</dd></div>
        <div><dt>Cinema</dt><dd>{ticket.cinema}</dd></div>
        <div><dt>Showtime</dt><dd>{formatShowtime(ticket.showtime)}</dd></div>
        <div><dt>Seats</dt><dd>{ticket.seats}</dd></div>
        <div><dt>Price per seat</dt><dd>{formatCents(ticket.unit_price_cents)}</dd></div>
        <div class="grand"><dt>Total</dt><dd>{formatCents(total)}</dd></div>
      </dl>

      {ticket.status === "booked" && (
        <>
          <button id="pay" class="primary">Pay {formatCents(total)}</button>
          <p class="form-status" id="pay-status" role="status"></p>
        </>
      )}

      {ticket.status !== "booked" && (
        <div class="confirmed">
          <p class="label">{ticket.status === "paid" ? "Paid — show this at the door" : "Redeemed"}</p>
          <p class="code">{ticket.confirmation}</p>
          <a class="jw-link" href="/tickets">Go to My Tickets →</a>
        </div>
      )}
    </div>
  </body>
</html>

<script>
  import { rememberTicketId } from "../../lib/ticket-storage.js";

  const panel = document.querySelector("[data-ticket-id]");
  const ticketId = panel.dataset.ticketId;

  // Also remember here, so opening a checkout link in a new browser adds the
  // ticket to that browser's list. The id is the only credential there is.
  rememberTicketId(ticketId);

  document.getElementById("pay")?.addEventListener("click", async (event) => {
    const button = event.currentTarget;
    const status = document.getElementById("pay-status");
    button.disabled = true;
    status.textContent = "Processing…";

    try {
      const res = await fetch(`/api/tickets/${ticketId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "pay" }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? `Payment failed (${res.status})`);

      // Re-render from the server rather than mirroring ticket state in JS:
      // one source of truth for what this ticket looks like.
      window.location.reload();
    } catch (err) {
      status.textContent = err.message;
      button.disabled = false;
    }
  });
</script>

<style>
  body { background: radial-gradient(circle at top, #1a1030, #0b0b16 70%); color: #fff; font-family: "Poppins", system-ui, sans-serif; margin: 0; padding: 2rem; min-height: 100vh; }
  .back { color: #a855f7; text-decoration: none; font-weight: 600; }
  .back:hover { text-decoration: underline; }
  .panel { max-width: 560px; margin: 2rem auto; background: #15152a; border-radius: 16px; padding: 1.75rem; }
  .panel h1 { margin-top: 0; font-size: 2rem; font-weight: 800; background: linear-gradient(90deg, #a855f7, #ec4899, #f59e0b); background-size: 200% auto; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; animation: shine 4s linear infinite; display: inline-block; }
  @keyframes shine { to { background-position: 200% center; } }
  .mock-note { background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.35); color: #fcd34d; padding: 0.7rem 1rem; border-radius: 12px; font-size: 0.85rem; line-height: 1.5; }
  .summary { margin: 1.5rem 0; }
  .summary div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.6rem 0; border-bottom: 1px solid #24243f; }
  .summary dt { color: #9ca3af; font-size: 0.9rem; margin: 0; }
  .summary dd { margin: 0; font-weight: 600; text-align: right; }
  .summary .grand { border-bottom: none; padding-top: 1rem; }
  .summary .grand dt, .summary .grand dd { font-size: 1.15rem; color: #ffd700; }
  .primary { border: none; border-radius: 30px; padding: 0.85rem 2rem; font-family: inherit; font-size: 1rem; font-weight: 600; color: #fff; background: linear-gradient(90deg, #a855f7, #ec4899); cursor: pointer; width: 100%; transition: transform 0.15s ease, opacity 0.2s ease; }
  .primary:hover:not(:disabled) { transform: translateY(-2px); }
  .primary:disabled { opacity: 0.55; cursor: default; }
  .form-status { color: #f87171; font-size: 0.9rem; min-height: 1.2em; margin: 0.8rem 0 0; text-align: center; }
  .confirmed { text-align: center; background: #1e1e38; border-radius: 12px; padding: 1.5rem; }
  .confirmed .label { color: #9ca3af; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.6rem; }
  .confirmed .code { font-size: 2rem; font-weight: 800; letter-spacing: 0.12em; margin: 0 0 1rem; color: #4ade80; }
  .jw-link { color: #a855f7; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
  .jw-link:hover { text-decoration: underline; }
</style>
